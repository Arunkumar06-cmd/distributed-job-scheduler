# Copy to .env (or export) before running services locally.
DATABASE_URL=postgres:///job_scheduler
NATS_URL=nats://127.0.0.1:4222
JWT_SECRET=change-me-to-at-least-32-random-bytes
RUST_ENV=development
API_HOST=0.0.0.0
API_PORT=8080
CORS_ALLOWED_ORIGIN=http://localhost:3000
API_RATE_LIMIT_PER_MIN=600

WORKER_ID=
WORKER_CONCURRENCY=8
HANDLER_TIMEOUT_SECS=600
HEARTBEAT_INTERVAL_SECS=5
LEASE_DURATION_SECS=30
SHUTDOWN_GRACE_SECS=30

OUTBOX_BATCH_SIZE=100
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_LEASE_SECS=30

SCHEDULER_POLL_INTERVAL_SECS=5

AI_SUMMARIES_ENABLED=false
# OPENAI_API_KEY=

UNKNOWN_RESOLUTION_POLICY=dlq
UNKNOWN_GRACE_SECS=900

ARCHIVE_AFTER_DAYS=0
ARCHIVE_BATCH_SIZE=500
LOG_RETENTION_SECS=604800
